# BKernel NVIDIA Pascal display profile
# Target: x86_64 systems with NVIDIA Pascal GPUs (including GTX 1050 Ti).
# Merge after the BubbleOS desktop fragment, then run olddefconfig.
#
# This fragment configures the in-tree Nouveau fallback only. The proprietary
# NVIDIA 580-series kernel module is an external DKMS build and is documented
# separately; proprietary sources/binaries are not vendored in this repository.

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# NVIDIA 580 does not support PREEMPT_RT; this profile is non-RT by design.
# The general BubbleOS desktop profile may enable RT for other use cases.
# CONFIG_PREEMPT_RT is not set

CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_ACPI=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y

CONFIG_FW_LOADER=y

CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_NOUVEAU=m

CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
